// Modelo de dados do Synergy.
// Convenção: identificadores em inglês no código; textos exibidos ao usuário em português (ver src/lib/labels.ts).
// Após alterar este arquivo: npm run db:migrate -- --name descreva_a_mudanca

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Perfil de acesso do usuário (RF: cadastro com perfis distintos).
enum Role {
  STARTUP
  INVESTOR
  PROFESSIONAL
  ADMIN
}

/// Plano da conta. Recursos premium: comunidade, roadmap burocrático e templates.
enum Plan {
  FREE
  PREMIUM
}

/// Estágio de maturidade da startup.
enum StartupStage {
  IDEA
  VALIDATION
  MVP
  TRACTION
  SCALE
}

enum EventType {
  HACKATHON
  MEETUP
  PITCH_DAY
  WORKSHOP
  DEMO_DAY
  OTHER
}

/// INTERNAL = organizado pela plataforma; EXTERNAL = divulgação de evento de terceiros.
enum EventOrigin {
  INTERNAL
  EXTERNAL
}

enum JobType {
  CLT
  PJ
  FREELANCE
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

/// Situação da sincronização de licitações de um estado com o PNCP.
enum TenderSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Situação da análise dos documentos de uma licitação (leitura do edital e extração dos requisitos).
/// PENDING = na fila (ou aguardando nova tentativa); UNAVAILABLE = não há documento legível.
enum TenderAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  UNAVAILABLE
}

/// Situação da organização dos requisitos por IA (opcional; depende de uma chave do OpenRouter).
enum TenderAiStatus {
  NONE
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Grupo de habilitação de um requisito (arts. 62 a 70 da Lei 14.133/2021).
enum TenderRequirementCategory {
  TECHNICAL
  FINANCIAL
  LEGAL
  FISCAL
  DECLARATION
  OTHER
}

// ---------------------------------------------------------------------------
// Usuários e perfis
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role
  plan            Plan      @default(FREE)
  planActivatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  startup         StartupProfile?
  investor        InvestorProfile?
  professional    ProfessionalProfile?
  attendances     EventAttendance[]
  organizedEvents Event[]
  forumPosts      ForumPost[]
  forumReplies    ForumReply[]
  aiKey           UserAiKey?
  aiReviews       TenderAnalysis[]
}

/// Chave de API do OpenRouter do próprio usuário, usada para organizar requisitos de editais com IA.
/// Fica fora de `User` para nunca entrar por engano em uma consulta de usuário.
model UserAiKey {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chave cifrada com AES-256-GCM (ver src/lib/crypto/secret-box.ts). Nunca é enviada ao navegador.
  ciphertext String   @db.VarChar(600)
  /// Últimos 4 caracteres, para o usuário reconhecer qual chave está salva.
  last4      String   @db.Char(4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Nicho de mercado usado para segmentar startups (fintech, healthtech, ...).
model Niche {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  slug     String           @unique
  startups StartupProfile[]
}

model StartupProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Frase curta que resume a startup (até 280 caracteres).
  pitch       String?      @db.VarChar(280)
  description String?      @db.Text
  website     String?
  city        String?
  stage       StartupStage @default(IDEA)
  nicheId     Int?
  niche       Niche?       @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  jobs            JobPosting[]
  roadmapProgress RoadmapProgress[]

  @@index([nicheId])
}

model InvestorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String?
  /// Tese de investimento: setores, estágios e tickets de interesse.
  thesis    String?  @db.Text
  ticketMin Int?
  ticketMax Int?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline              String?
  bio                   String?  @db.Text
  /// Habilidades separadas por vírgula (ex.: "React, Node.js, SQL").
  skills                String?
  linkedin              String?
  portfolio             String?
  availableForFreelance Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------------------

model Event {
  id            String      @id @default(cuid())
  title         String
  description   String      @db.Text
  type          EventType
  origin        EventOrigin @default(INTERNAL)
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  isOnline      Boolean     @default(false)
  externalUrl   String?
  capacity      Int?
  /// Até esta data a inscrição é exclusiva para contas Premium (sistema de prioridade).
  priorityUntil DateTime?
  organizerId   String
  organizer     User        @relation(fields: [organizerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  attendances EventAttendance[]

  @@index([startsAt])
}

/// Inscrição/presença em evento. Para investidores, representa a presença confirmada publicamente.
model EventAttendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vagas
// ---------------------------------------------------------------------------

model JobPosting {
  id          String         @id @default(cuid())
  startupId   String
  startup     StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title       String
  description String         @db.Text
  type        JobType
  workMode    WorkMode
  location    String?
  salaryRange String?
  /// Habilidades desejadas separadas por vírgula.
  skills      String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive, createdAt])
  @@index([startupId])
}

// ---------------------------------------------------------------------------
// Comunidade (Premium)
// ---------------------------------------------------------------------------

model ForumPost {
  id        String       @id @default(cuid())
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  replies   ForumReply[]

  @@index([createdAt])
}

model ForumReply {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  createdAt DateTime  @default(now())

  @@index([postId])
}

// ---------------------------------------------------------------------------
// Roadmap burocrático e templates (Premium)
// ---------------------------------------------------------------------------

/// Passo do roadmap burocrático (CNPJ, contrato social, marca, etc.). Conteúdo vem do seed.
model RoadmapStep {
  id          Int               @id @default(autoincrement())
  order       Int
  phase       String
  title       String
  description String            @db.Text
  resourceUrl String?
  progress    RoadmapProgress[]

  @@index([order])
}

/// Progresso de uma startup em um passo do roadmap.
model RoadmapProgress {
  id          String         @id @default(cuid())
  startupId   String
  startup     StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)
  stepId      Int
  step        RoadmapStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([startupId, stepId])
}

/// Template de landing page para captação. O arquivo fica em /public/templates.
model LandingPageTemplate {
  id          Int    @id @default(autoincrement())
  name        String
  description String @db.Text
  category    String
  fileUrl     String
}

// ---------------------------------------------------------------------------
// Licitações (espelho do PNCP para busca por nicho)
// ---------------------------------------------------------------------------

/// Licitação com propostas abertas, copiada da API oficial de consultas do PNCP.
/// A API não tem busca por palavra-chave, por isso o casamento com o nicho é feito aqui (src/lib/tenders).
model Tender {
  id                  String    @id @default(cuid())
  /// Número de controle PNCP (ex.: "78200482000110-1-000010/2026"): identidade oficial da contratação.
  pncpId              String    @unique @db.VarChar(40)
  /// Objeto da contratação, como publicado pelo órgão.
  object              String    @db.Text
  /// Objeto normalizado (minúsculas, sem acentos, plural reduzido, com espaço nas pontas) para busca
  /// por palavra inteira com LIKE. Gerado por `toSearchText` em src/lib/tenders/text.ts.
  searchText          String    @db.Text
  agencyName          String
  agencyCnpj          String    @db.Char(14)
  unitName            String?
  city                String?
  uf                  String    @db.Char(2)
  modalityId          Int
  modalityName        String
  /// Número da compra no órgão (não confundir com o sequencial do PNCP).
  number              String?
  /// Valor total estimado em reais; nulo quando não informado ou sigiloso.
  estimatedValue      Decimal?  @db.Decimal(18, 2)
  /// Sistema de Registro de Preços (SRP).
  isPriceRegistration Boolean   @default(false)
  opensAt             DateTime?
  /// Fim do recebimento de propostas.
  closesAt            DateTime
  publishedAt         DateTime
  /// Link do sistema de origem, onde a proposta é enviada (quando informado pelo órgão).
  sourceUrl           String?   @db.VarChar(500)
  /// Última sincronização em que a licitação apareceu como aberta (usado para remover as encerradas).
  lastSeenAt          DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  analysis TenderAnalysis?

  @@index([uf, closesAt])
  @@index([closesAt])
}

/// Análise dos documentos oficiais de uma licitação (uma por licitação, compartilhada por todas as startups).
/// É feita em segundo plano (src/lib/tenders/analysis.ts): baixar do PNCP é lento e falha com frequência.
/// Some junto com a licitação quando ela deixa de aceitar propostas.
model TenderAnalysis {
  tenderId         String               @id
  tender           Tender               @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status           TenderAnalysisStatus @default(PENDING)
  /// Pedidos de usuários (1) passam à frente da fila automática pós-sincronização (0).
  priority         Int                  @default(0)
  /// Tentativas de baixar e ler os documentos já feitas.
  attempts         Int                  @default(0)
  /// Só volta a ser processada depois deste momento (espera entre tentativas).
  nextAttemptAt    DateTime             @default(now())
  /// Atualizado durante o processamento; permite detectar execuções interrompidas.
  heartbeatAt      DateTime?
  completedAt      DateTime?
  /// Motivo da última falha ou da indisponibilidade, em português, exibido ao usuário.
  error            String?              @db.VarChar(300)
  /// Documentos lidos: [{ type, title, kind, pages, textPages }].
  documents        Json?
  /// Exigências encontradas (sem contar as regras de procedimento).
  requirementCount Int                  @default(0)

  aiStatus        TenderAiStatus @default(NONE)
  /// Modelo que respondeu (ex.: "nvidia/nemotron-3.5-super-vl:free").
  aiModel         String?
  aiError         String?        @db.VarChar(300)
  aiHeartbeatAt   DateTime?
  aiCompletedAt   DateTime?
  /// Quem pediu a organização por IA: a chave dessa pessoa é usada, se ela tiver uma.
  aiRequestedById String?
  aiRequestedBy   User?          @relation(fields: [aiRequestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements TenderRequirement[]

  @@index([status, nextAttemptAt])
  @@index([aiStatus])
  @@index([aiRequestedById])
}

/// Cláusula da seção de habilitação de um edital, com o texto literal e onde ela está.
model TenderRequirement {
  id           String                    @id @default(cuid())
  tenderId     String
  analysis     TenderAnalysis            @relation(fields: [tenderId], references: [tenderId], onDelete: Cascade)
  /// Ordem em que a cláusula aparece nos documentos.
  position     Int
  category     TenderRequirementCategory
  /// Regra de procedimento (como a administração conduz a habilitação), não exigência à empresa.
  procedural   Boolean                   @default(false)
  /// Numeração da cláusula no documento ("8.1.3", "a)"), quando houver.
  label        String?                   @db.VarChar(24)
  /// Texto literal da cláusula: nada é reescrito.
  text         String                    @db.Text
  /// Tipo do documento de origem no PNCP ("Edital", "Termo de Referência"...).
  documentType String                    @db.VarChar(80)
  page         Int

  /// Classificação da IA; nula enquanto a IA não organizou a licitação.
  aiCategory   TenderRequirementCategory?
  aiProcedural Boolean?
  /// Título curto escrito pela IA (só é gravado se todos os números dele existirem em `text`).
  aiTitle      String?                    @db.VarChar(200)
  /// Exigência que pode impedir uma empresa pequena de participar (capital mínimo, atestado com quantitativo...).
  aiHighlight  Boolean?

  @@unique([tenderId, position])
}

/// Controle da sincronização de licitações por estado (uma linha por UF).
model TenderSync {
  uf          String           @id @db.Char(2)
  status      TenderSyncStatus
  startedAt   DateTime
  /// Atualizado a cada página processada; permite detectar execuções interrompidas.
  heartbeatAt DateTime
  /// Fim da última sincronização completa (define a "idade" dos dados exibidos).
  completedAt DateTime?
  pagesDone   Int              @default(0)
  totalPages  Int?
  /// Licitações abertas do estado após a última sincronização completa.
  tenderCount Int              @default(0)
  error       String?          @db.VarChar(300)
  updatedAt   DateTime         @updatedAt
}
